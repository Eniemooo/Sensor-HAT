# Copy to secrets.yaml (next to your device YAML) and replace every value with your own.
# The placeholders below are rejected by `esphome config` on purpose.
wifi_ssid: "MeinWLAN"
wifi_password: "MeinWLANPasswort"
# 32 random bytes, base64-encoded; also protects OTA updates. Create one with:  openssl rand -base64 32
api_encryption_key: "REPLACE-with-output-of-openssl-rand-base64-32"
# Fallback hotspot when the Wi-Fi is unreachable: your own, at least 8 characters
ap_password: "CHANGE"
